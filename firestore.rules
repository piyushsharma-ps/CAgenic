rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }

      // Attention items subcollection
      match /attention_items/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
      }

      // Audit activity logs subcollection
      match /activities/{activityId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(activityId);
      }
    }
  }
}
